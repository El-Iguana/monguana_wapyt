# Copy to .env and edit before running.

# ── First run ────────────────────────────────────────────────────────────────
# Used only when the users table is empty.
MONGUANA_ADMIN_USER=admin
MONGUANA_ADMIN_PASS=change-me-before-exposing

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite database, secret.key and session.key live here. Leave it unset: the
# container uses /data (its volume) and a local run uses ./data. Setting it
# here would also override the container's /data and put the database outside
# the volume, where recreating the container loses it.
# MONGUANA_DATA_DIR=./data

# Fernet key for credential encryption. Generated into secret.key on first run
# if unset. Back up whichever you use: losing it loses every stored password.
# MONGUANA_SECRET_KEY=

# ── Service ──────────────────────────────────────────────────────────────────
# Port on this computer (compose publishes it on 127.0.0.1 only).
MONGUANA_PORT=8766

# Password for the optional bundled MongoDB (docker compose --profile mongo).
# MONGO_ROOT_PASSWORD=change-me-too

# Largest dump ZIP accepted by Restore. Default 1 GiB.
# MONGUANA_MAX_RESTORE_BYTES=1073741824

# Behind a TLS-terminating reverse proxy: the public origin and host name.
# MONGUANA_CANONICAL_ORIGIN=https://mongo.example.com
# MONGUANA_ALLOWED_HOSTS=mongo.example.com
